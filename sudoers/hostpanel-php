%hostpanel ALL=(root) NOPASSWD: /bin/systemctl daemon-reload
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl enable hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl disable hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl start hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl stop hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl restart hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl reload hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/systemctl is-active hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /bin/journalctl -u hostpanel-php-fpm
%hostpanel ALL=(root) NOPASSWD: /usr/bin/tee /etc/systemd/system/hostpanel-php-fpm.service
%hostpanel ALL=(root) NOPASSWD: /bin/chmod 644 /etc/systemd/system/hostpanel-php-fpm.service
%hostpanel ALL=(root) NOPASSWD: /bin/rm -f /etc/systemd/system/hostpanel-php-fpm.service
%hostpanel ALL=(root) NOPASSWD: /bin/mkdir -p /opt/hostpanel/plugins/php/pools
%hostpanel ALL=(root) NOPASSWD: /bin/mkdir -p /opt/hostpanel/plugins/php/logs
%hostpanel ALL=(root) NOPASSWD: /bin/mkdir -p /opt/hostpanel/plugins/php/run
%hostpanel ALL=(root) NOPASSWD: /bin/mkdir -p /run/hostpanel-php
%hostpanel ALL=(root) NOPASSWD: /usr/bin/tee /opt/hostpanel/plugins/php/pools/*.conf
%hostpanel ALL=(root) NOPASSWD: /bin/chmod 644 /opt/hostpanel/plugins/php/pools/*.conf
%hostpanel ALL=(root) NOPASSWD: /bin/rm -f /opt/hostpanel/plugins/php/pools/*.conf
%hostpanel ALL=(root) NOPASSWD: /bin/rm -f /run/hostpanel-php/*.sock
%hostpanel ALL=(root) NOPASSWD: /bin/rm -rf /opt/hostpanel/plugins/php
%hostpanel ALL=(root) NOPASSWD: /bin/rm -f /etc/sudoers.d/hostpanel-php
%hostpanel ALL=(root) NOPASSWD: /opt/hostpanel/plugins/php/php-fpm-8.4 -t --fpm-config /opt/hostpanel/plugins/php/conf/php-fpm.conf
%hostpanel ALL=(root) NOPASSWD: /usr/bin/tee /opt/hostpanel/plugins/nginx/vhosts/*.conf
%hostpanel ALL=(root) NOPASSWD: /opt/hostpanel/plugins/nginx/nginx -t
%hostpanel ALL=(root) NOPASSWD: /opt/hostpanel/plugins/nginx/nginx -s reload
